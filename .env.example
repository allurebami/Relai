# Adresse stable de production, sans chemin. Les callbacks doivent être enregistrés
# à l'identique dans les consoles des réseaux. HTTPS obligatoire en production.
RELAI_APP_URL=

# Installer Upstash Redis depuis Vercel Marketplace puis l'attacher à Relai.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Générer avec : node scripts/create-social-secrets.mjs
# Clé AES : 64 caractères hexadécimaux. Ne pas la changer sans migrer les connexions.
RELAI_TOKEN_ENCRYPTION_KEY=
RELAI_ADMIN_PASSWORD_HASH=

# Chaque réseau est activable indépendamment. Aucune variable NEXT_PUBLIC.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
